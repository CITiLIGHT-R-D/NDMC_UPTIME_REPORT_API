# NDMC report automation — configuration
#
# SETUP:
#   1. Copy this file to  config.env  (same folder)
#   2. Fill in the portal username and password
#   3. Restrict who can read it — it holds a high-privilege account:
#        icacls config.env /inheritance:r /grant:r "$env:USERNAME:(R)"
#
# config.env is git-ignored and must NEVER be committed.

# Portal login for https://smartlight.citilight.co:446
NDMC_USER=
NDMC_PASS=

# Which month to report on.
#   last   = the month that just ended  <-- use this for the scheduled job
#   1-12   = a specific month (NDMC_YEAR then applies)
# run-monthly.ps1 sets this itself, so normally leave it alone.
NDMC_MONTH=last

# Optional: pin a year. Leave blank so "last" rolls back correctly in January.
NDMC_YEAR=

# ---------------------------------------------------------------------------
# EMAIL — same account and settings as D:\ConnectivityReport
# ---------------------------------------------------------------------------
# You can copy these three values straight out of
#   D:\ConnectivityReport\mail.env.bat
# (they are the same Gmail account and the same app password).
#
# Gmail needs an APP PASSWORD, not the normal account password:
#   myaccount.google.com -> Security -> 2-Step Verification -> App passwords
MAIL_USER=aditi.mishra@citilight.co
MAIL_PASS=
MAIL_FROM=aditi.mishra@citilight.co

# Recipients are NOT set here — edit recipients.txt (one address per line).
# Optional extra CC addresses, comma-separated:
MAIL_CC=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Set to 0 to generate the reports but skip sending them.
MAIL_ENABLED=1
