# Dependencies
node_modules/

# Generated Excel reports and large data files
*.xlsx

# Excel lock/temp files
~$*

# Local archives / exports (e.g. a zipped copy of docs/ — the real files are tracked)
*.zip

# Download checkpoints (per-chunk totals so a failed run resumes instead of
# restarting). Safe to delete any time — it just forces a clean re-download.
.cache/

# Portal credentials for the scheduled job — NEVER commit. Only the .example is tracked.
config.env

# Scheduled-run logs and the single-run lock
Logs/
.run.lock

# Background task output / logs
*.output
*.log

# OS / editor cruft
.DS_Store
Thumbs.db

# Claude Code harness config
.claude/

# Scheduler state (which months have been completed)
.scheduler-state.json
